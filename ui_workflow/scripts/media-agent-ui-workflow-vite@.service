[Unit]
Description=media_agent ui_workflow Vite development server (%f)

[Service]
Type=simple
WorkingDirectory=%f
ExecStart=/usr/bin/env npm run dev -- --host 0.0.0.0 --port 5173 --strictPort
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
