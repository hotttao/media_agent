# media-cli 本机环境变量
#
# godotenv 在 config.NewLoader() 时自动加载（不存在不报错）。
# 约定与 media_example/.env 一致：conf/<APP_ENV>.yaml 是 source of truth，
# .env 只放 APP_ENV 与少量进程级 override。

APP_ENV=local

# 结构化应用日志
LOG_LEVEL=debug
LOG_ENABLED=true
LOG_DIR=

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORT_ENDPOINT=localhost:4317

# 被测服务默认地址（client.media_example.base_domain 的 fallback）
MEDIA_EXAMPLE_ADDR=http://127.0.0.1:8888