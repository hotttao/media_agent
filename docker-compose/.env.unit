# .env.unit —— 单元测试/单服务调试：只起 pg，其他 infra 全部关闭。
# 用法：INFRA=unit docker compose -f media_auth/docker-compose.yml up media_auth
APP_ENV=dev
POSTGRES_ENABLED=true
OTEL_ENABLED=false
PROMETHEUS_ENABLED=false
LOKI_ENABLED=false
GRAFANA_ENABLED=false
JAEGER_ENABLED=false
PROMTAIL_ENABLED=false
CONSUL_ENABLED=false
CONSUL_KV_ENABLED=false
# auth 中间件（materials + workflow 共享）
MW_JWT_SECRET=mw-shared-secret-change-me
MW_MATERIALS_OAUTH_CLIENT_SECRET=mw_materials_secret_dev
MW_WORKFLOW_OAUTH_CLIENT_SECRET=mw_workflow_secret_dev
