# .env.e2e —— 联调全部：起 pg + 所有 infra（otel/jaeger/prometheus/loki/grafana/promtail/consul）。
# 用法：INFRA=e2e docker compose -f media_auth/docker-compose.yml up media_auth
APP_ENV=local
POSTGRES_ENABLED=true
OTEL_ENABLED=true
PROMETHEUS_ENABLED=true
LOKI_ENABLED=true
GRAFANA_ENABLED=true
JAEGER_ENABLED=true
PROMTAIL_ENABLED=true
CONSUL_ENABLED=true
CONSUL_KV_ENABLED=true
# auth 中间件（materials + workflow 共享）
MW_JWT_SECRET=mw-shared-secret-change-me
MW_MATERIALS_OAUTH_CLIENT_SECRET=mw_materials_secret_dev
MW_WORKFLOW_OAUTH_CLIENT_SECRET=mw_workflow_secret_dev
# 下游服务 URL（docker 环境用 host.docker.internal；本地 go run 时 yaml 默认 127.0.0.1）
MEDIA_AUTH_URL=http://host.docker.internal:8001
MEDIA_MATERIALS_URL=http://host.docker.internal:8003
