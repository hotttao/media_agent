# 本地开发常用的 Docker 查询和生命周期操作。
# 删除容器/镜像/卷以及 system prune 不在放行范围内，仍需显式确认。
prefix_rule(pattern = ["docker", "info"], decision = "allow", justification = "inspect Docker daemon")
prefix_rule(pattern = ["docker", "version"], decision = "allow", justification = "inspect Docker versions")
prefix_rule(pattern = ["docker", "ps"], decision = "allow", justification = "list running containers")
prefix_rule(pattern = ["docker", "images"], decision = "allow", justification = "list local images")
prefix_rule(pattern = ["docker", "inspect"], decision = "allow", justification = "inspect Docker resources")
prefix_rule(pattern = ["docker", "logs"], decision = "allow", justification = "read container logs")
prefix_rule(pattern = ["docker", "stats"], decision = "allow", justification = "inspect container resource usage")
prefix_rule(pattern = ["docker", "exec"], decision = "allow", justification = "execute diagnostics in a running container")
prefix_rule(pattern = ["docker", "network", "ls"], decision = "allow", justification = "list Docker networks")
prefix_rule(pattern = ["docker", "volume", "ls"], decision = "allow", justification = "list Docker volumes")

# Compose 开发流程：查询、构建、启动、停止、重启和查看日志。
prefix_rule(pattern = ["docker", "compose", "config"], decision = "allow", justification = "validate Compose configuration")
prefix_rule(pattern = ["docker", "compose", "up"], decision = "allow", justification = "start development containers")
prefix_rule(pattern = ["docker", "compose", "build"], decision = "allow", justification = "build development images")
prefix_rule(pattern = ["docker", "compose", "start"], decision = "allow", justification = "start stopped development containers")
prefix_rule(pattern = ["docker", "compose", "stop"], decision = "allow", justification = "stop development containers")
prefix_rule(pattern = ["docker", "compose", "restart"], decision = "allow", justification = "restart development containers")
prefix_rule(pattern = ["docker", "compose", "ps"], decision = "allow", justification = "list Compose services")
prefix_rule(pattern = ["docker", "compose", "logs"], decision = "allow", justification = "read Compose service logs")
prefix_rule(pattern = ["docker", "compose", "exec"], decision = "allow", justification = "execute diagnostics in a Compose service")
