# media_example 本机环境变量
#
# godotenv 在 config.NewLoader() 时自动加载本文件（不存在不报错）；
# 生产环境通过容器 / systemd 注入 env，不需要 .env。
#
# 约定（harness/contributing/config.md）：
#   - conf/<APP_ENV>.yaml 是配置的 source of truth；
#   - .env 只放 APP_ENV 与少量进程级 override（DSN、LOG_DIR 等）。
#   - 想切换环境：APP_ENV=dev / APP_ENV=local / APP_ENV=prod ...

APP_ENV=local

# 服务监听 / 对外注册地址
SERVER_ADDR=:8888
SERVER_ADVERTISE_ADDR=127.0.0.1:8888

# 结构化应用日志（zap + lumberjack）；e2e 时设 LOG_DIR 指向 media_logs/media_example 绝对路径
# LOG_DIR 通常由 e2e 脚本注入，本地开发留空即可（仅写 stdout）
LOG_LEVEL=debug
LOG_ENABLED=true
LOG_DIR=

# 数据库（DSN 走环境变量注入；enabled 走 yaml）
MYSQL_DSN=user:pass@tcp(127.0.0.1:3306)/media_example?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# Consul
CONSUL_ADDR=127.0.0.1:8500
CONSUL_SERVICE_NAME=media-example
CONSUL_SERVICE_ADDRESS=127.0.0.1
CONSUL_SERVICE_PORT=8888

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORT_ENDPOINT=localhost:4317

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_ADDR=:9091

# Consul KV（热更新）
CONSUL_KV_ENABLED=false
CONSUL_KV_ADDR=127.0.0.1:8500
CONSUL_KV_DATA_ID=media-example/config