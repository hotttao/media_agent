# media_example 本机环境变量
#
# godotenv 在 config.NewLoader() 时自动加载本文件（不存在不报错）；
# 生产环境通过容器 / systemd 注入 env，不需要 .env。
#
# 约定（harness/contributing/config.md）：
#   - conf/<APP_ENV>.yaml 是配置的 source of truth；
#   - .env 只放 APP_ENV 与少量进程级 override（DSN、LOG_DIR 等）。
#   - 想切换环境：APP_ENV=dev / APP_ENV=local / APP_ENV=prod ...

APP_ENV=local
