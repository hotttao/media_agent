    "servers": {
      "media": {
        "type": "remote",
        "url": "http://mini-001.local:18080/mcp",
        "oauth": false,
        "codemode": false,
        "headers": {
          "Authorization": "Bearer <User Token>",
          "X-Media-Organization-ID": "<\u4f01\u4e1a ID>",
          "X-Media-Workspace-ID": "<Workspace ID>"
